PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d
PARTNER_PII_ENCRYPTION_KEY=
# Rotation-ready alternative: a secret-manager JSON map and active key ID (do not commit real values).
PARTNER_PII_ENCRYPTION_KEYS=
PARTNER_PII_ACTIVE_KEY_ID=
CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE=5242880
# Optional; defaults to backend/private-documents. Keep this on a persistent private volume in production.
DOCUMENT_STORAGE_PATH=./private-documents
# DOCX conversion uses LibreOffice when installed; Windows can fall back to Microsoft Word.
# Set this when LibreOffice's executable is not on PATH.
# LIBREOFFICE_PATH=/usr/bin/soffice
